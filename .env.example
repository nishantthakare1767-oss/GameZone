# ---------------------------------------------------------------------------
# GameHub Control Center — environment configuration
# Copy to .env and fill in. Never commit real credentials.
# ---------------------------------------------------------------------------

# Node environment: development | production | test
NODE_ENV=development

# HTTP port of the local café server
PORT=4000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Primary (café server): a real PostgreSQL instance, e.g.
#   DATABASE_URL=postgres://gamehub:strong-password@127.0.0.1:5432/gamehub
#
# Leave empty (or use pglite:<dir>) to run an embedded PostgreSQL database
# stored inside DATA_DIR. This is the zero-install mode for a single-box
# café server and for automated tests. Both modes use identical SQL.
DATABASE_URL=
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Session lifetime for dashboard sign-in (hours)
SESSION_TTL_HOURS=12
SESSION_COOKIE_NAME=gamehub_session
# Set to true when the dashboard is served over HTTPS (required for remote access)
COOKIE_SECURE=false
# How many sign-in attempts per IP per minute
LOGIN_RATE_LIMIT=20

# Bootstrap administrator, created only when the users table is empty.
# In production, ADMIN_PASSWORD is required; otherwise a random password is
# generated and written to the server log once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Dashboard / CORS
# ---------------------------------------------------------------------------
# Comma separated allowed origins for the dashboard and WebSocket.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000
# Trust X-Forwarded-* headers. Enable only behind a reverse proxy you control.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Session engine
# ---------------------------------------------------------------------------
# How often the expiry worker scans (ms)
EXPIRY_SCAN_INTERVAL_MS=5000
# Seed demo devices/sessions on start (development only)
SEED_ON_START=false
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PlayStation bridge (only if you operate a verified venue-management bridge)
# ---------------------------------------------------------------------------
PS_BRIDGE_API_KEY=
